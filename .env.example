# NestJS API (server-only)
PORT=8080
FIREBASE_PROJECT_ID=wilhite-portfolio
# Paste full service account JSON as one line, or set path via GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated origins for CORS (production frontend URL)
CORS_ORIGINS=http://localhost:5173,https://wilhite-portfolio.pages.dev

# Optional: require password for dashboard API (Nest local + Cloudflare Pages)
# DASHBOARD_PASSWORD=your-secret-here

# Gemini — required for receipt/screenshot expense scanning (/api/expenses/scan),
# STR co-host (/api/agent/chat), and Construction Manager (/api/agent/construction/chat)
# Cloudflare Pages: Settings → Environment variables → GEMINI_API_KEY (encrypted)
# Local NestJS: set here or in api/.env
GEMINI_API_KEY=

# AI co-host — optional voice fallback (Whisper when Web Speech API unavailable)
OPENAI_API_KEY=

# Gmail integration for co-host (OAuth + draft replies)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: PriceLabs API for competitive pricing (Tier A comp fetch)
PRICELABS_API_KEY=

# Receipt image storage (Firebase Storage) — same service account as Firestore
# Cloudflare Pages: add FIREBASE_SERVICE_ACCOUNT_JSON (encrypted) to save receipt photos
# Optional: FIREBASE_STORAGE_BUCKET=wilhite-portfolio.appspot.com
# Large construction plans/PDFs: strongly recommended for Firebase (KV limit ~4 MB per file)

# Vite frontend (web/.env)
# VITE_API_URL=http://localhost:8080
