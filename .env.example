# NestJS API (server-only)
PORT=8080
FIREBASE_PROJECT_ID=wilhite-portfolio
# Paste full service account JSON as one line, or set path via GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated origins for CORS (production frontend URL)
CORS_ORIGINS=http://localhost:5173,https://wilhite-portfolio.pages.dev

# Optional: require password for dashboard API (Nest local + Cloudflare Pages)
# DASHBOARD_PASSWORD=your-secret-here

# Gemini — required for receipt/screenshot expense scanning (/api/expenses/scan)
# Cloudflare Pages: Settings → Environment variables → GEMINI_API_KEY (encrypted)
# Local NestJS: set here or in api/.env
GEMINI_API_KEY=

# Vite frontend (web/.env)
# VITE_API_URL=http://localhost:8080
