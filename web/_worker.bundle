    const endRaw = dtEnd ?? dtStart;
    const end = `${endRaw.slice(0, 4)}-${endRaw.slice(4, 6)}-${endRaw.slice(6, 8)}`;
    events.push({ uid, start, end, summary, propertyId, source: "ical" });
  }
  return events;
}
