{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:guards": "node scripts/check-route-guards.cjs",
    "check:functions": "tsc -p tsconfig.functions.json",
    "check:deployed": "node scripts/check-deployed.mjs",
    "live:routes": "node scripts/list-live-routes.mjs",
    "test": "tsx --test \"src/lib/**/*.test.ts\" \"functions/**/*.test.ts\"",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "deploy:skip-checks": "node scripts/deploy.mjs --skip-checks"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.94.0"
  }
}
